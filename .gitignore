# ==============================================================================
# BBPlayer Git Ignore Rule
# 仅保留源码、构建图标、配置文件与技术文档
# ==============================================================================

# 依赖管理 (Dependencies)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 构建产物与打包输出 (Build Artifacts & Packaging Output)
dist/
release-dist/
build/win-unpacked/
out/
*.exe
*.blockmap
*.yml
*.dmg
*.pkg
*.app
*.apk
*.deb
*.rpm
*.zip
*.tar.gz

# 运行时缓存与临时数据 (Runtime Logs & Temp)
.tmp/
temp/
logs/
*.log

# 操作系统与平台缓存 (OS Specific)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 编辑器与 IDE 配置 (IDEs & Editors)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# AI 辅助与环境配置 (AI & Environment)
.env
.env.local
.env.*.local
.reasonix/
